<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <AssemblyName>reap</AssemblyName>
    <ApplicationIcon>ReaperIcon.ico</ApplicationIcon>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Version>1.1.0</Version>
    <Product>Reaper</Product>
    <Company>somethingSTRANGE</Company>
    <Copyright>Copyright © 2026 Michael Ryan</Copyright>
    <Description>Age-based pruning tool for scratch and temp directories.</Description>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildTime" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ'))" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7" />
    <!-- Microsoft.Data.Sqlite 10.0.7 pins SQLitePCLRaw to 2.1.11, which bundles a SQLite build
         vulnerable to CVE-2025-6965 (GHSA-2m69-gcr7-jv3q). Override to the 2.1.12 maintenance
         release, which stays on the same compatible line but references the patched native lib. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Spectre.Console" Version="0.55.2" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
    <PackageReference Include="Tomlyn" Version="2.3.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Preserve Reaper and Spectre types so reflection-based CLI wiring survives trimming -->
    <TrimmerRootAssembly Include="reap" />
    <TrimmerRootAssembly Include="Spectre.Console.Cli" />
    <TrimmerRootAssembly Include="Spectre.Console" />
  </ItemGroup>

</Project>
